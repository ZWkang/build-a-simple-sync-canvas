{
  "name": "sync-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.19",
  "workspaces": [
    "apps/*"
  ],
  "description": "A Bun workspace for the Sync Canvas frontend and backend applications.",
  "engines": {
    "bun": ">=1.2.19"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/bun": "^1.2.19",
    "@types/node": "^22.19.21",
    "@typescript/native-preview": "^7.0.0-dev.20260614.1",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.69.0",
    "prettier": "^3.8.4",
    "simple-git-hooks": "^2.13.1",
    "zwkang-prettier-config": "^0.0.3"
  },
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run format:check && bun run build",
    "dev": "bun run --parallel --filter './apps/*' dev",
    "dev:backend": "bun --cwd apps/backend run dev",
    "dev:frontend": "bun --cwd apps/frontend run dev",
    "format": "prettier --write --ignore-unknown apps scripts AGENTS.md README.md CONTRIBUTING.md package.json tsconfig.base.json",
    "format:check": "prettier --check --ignore-unknown apps scripts AGENTS.md README.md CONTRIBUTING.md package.json tsconfig.base.json",
    "lint": "oxlint apps scripts",
    "release": "bun run scripts/release.ts",
    "test": "bun test apps",
    "typecheck": "tsgo --noEmit -p scripts/tsconfig.json && bun run --filter './apps/*' typecheck",
    "update-deps": "bun update --latest",
    "setup": "bun install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix",
    "*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,md}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged",
    "commit-msg": "bunx commitlint --edit \"$1\""
  },
  "trustedDependencies": [
    "simple-git-hooks"
  ],
  "license": "MIT"
}
